// LPDDR4 x16 memory model (Synopsys LPDDR VIP behind verif/lpddr_model.v)
// for any testbench that hangs a DRAM device off the dram_wrapper pins.
// Needs the VIP generated under verif/models (make build_vip_models) and the
// usual SVT/UVM compile options from the including testbench.

+define+SVT_LPDDR_TIMESCALE
+define+SVT_LPDDR_CA_WIDTH=6 +define+SVT_LPDDR_MAX_DQS_WIDTH=2 +define+SVT_LPDDR_MAX_DQ_WIDTH=16 +define+SVT_LPDDR4_MAX_DMI_WIDTH=2

+incdir+${LPDDR4_PROJECT_DIR}/verif/models/lpddr_vip/src/sverilog/vcs
+incdir+${LPDDR4_PROJECT_DIR}/verif/models/lpddr_vip/include/sverilog
+incdir+${LPDDR4_PROJECT_DIR}/verif/models/lpddr_vip/src/verilog/vcs
+incdir+${LPDDR4_PROJECT_DIR}/verif/models/lpddr_vip/include/verilog
${LPDDR4_PROJECT_DIR}/verif/lpddr_model.v
